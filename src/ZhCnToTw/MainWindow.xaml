<Window x:Class="ZhCnToTw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:ZhCnToTw"
        mc:Ignorable="d"
        Title="繁化助手" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 對應 Mac 版 ContentView.swift 的工具列：畫在 WebView 外面的
             原生殼 UI，不是網頁本身的一部分。重新整理鍵在網頁卡住、或
             WebView2 背後的 render process 掛掉時，是使用者唯一能自救
             的方式。 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <Button x:Name="ReloadButton" Content="⟳ 重新整理" Padding="8,4" Click="ReloadButton_Click" />
        </StackPanel>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />
    </Grid>
</Window>
